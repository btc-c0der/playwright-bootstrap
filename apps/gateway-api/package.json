{
  "name": "@qaf/gateway-api",
  "version": "0.1.0",
  "private": true,
  "description": "Layer 1 (Consumers & Entrypoints) of the AI-Driven QA Platform: an MCP server for IDE integration and a Fastify REST API + CI/CD webhooks (GitHub Actions / Azure DevOps), both fronting @qaf/orchestrator's QAAgentOrchestrator. Not published — this is the deployable service docker-compose.yml runs.",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "qaf-gateway-rest": "./dist/bin/rest-server.js",
    "qaf-gateway-mcp": "./dist/bin/mcp-server.js"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --emitDeclarationOnly false --noEmit",
    "lint": "eslint . --config ../../eslint.config.js",
    "clean": "rm -rf dist *.tsbuildinfo",
    "start": "node dist/bin/rest-server.js",
    "start:mcp": "node dist/bin/mcp-server.js",
    "demo": "tsx src/scripts/demo-e2e-flow.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@qaf/core": "workspace:*",
    "@qaf/engine-contracts": "workspace:*",
    "@qaf/graph-rag": "workspace:*",
    "@qaf/llm-gateway": "workspace:*",
    "@qaf/orchestrator": "workspace:*",
    "@qaf/rag-core": "workspace:*",
    "@qaf/storage-core": "workspace:*",
    "@qaf/synth-data": "workspace:*",
    "fastify": "^5.0.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.0",
    "typescript": "^5.7.2"
  }
}
