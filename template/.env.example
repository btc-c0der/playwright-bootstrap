# Copy to .env and fill in for your environment. Never commit the real .env.
# Leave unset to run the example suite against the built-in local demo server
# (tests/fixtures/server) on http://localhost:4319. Point these at your real
# app/API once you replace the example specs — {{APP_BASE_URL}} is what you
# gave create-qaf as the app's base URL.
APP_BASE_URL={{APP_BASE_URL}}
API_BASE_URL={{APP_BASE_URL}}

# Set to "true" to enable the optional AI-repair hook on locator resolution
# failures (see docs/locator-resolver.md). Requires QAF_AI_REPAIR_API_KEY.
QAF_AI_REPAIR_ENABLED=false
QAF_AI_REPAIR_API_KEY=

# debug | info | warn | error. Defaults to debug locally, info in CI.
QAF_LOG_LEVEL=
