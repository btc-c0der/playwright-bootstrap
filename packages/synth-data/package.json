{
  "name": "@qaf/synth-data",
  "version": "0.1.0",
  "description": "AI-driven synthetic test data generation engine for SIT: ingests DB/OpenAPI/JSON schema constraints into a RAG-backed Constraint Rules Registry, generates JIT relational payloads from natural-language requests with a validate/self-correct guardrail loop, and seeds/tears down staging targets under per-worker isolation keys. Opt-in — ships only local/no-op defaults.",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/api/client.d.ts",
      "default": "./dist/api/client.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "qaf-synth-ingest": "./dist/bin/qaf-synth-ingest.js",
    "qaf-synth-generate": "./dist/bin/qaf-synth-generate.js",
    "qaf-synth-serve": "./dist/bin/qaf-synth-serve.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --emitDeclarationOnly false --noEmit",
    "lint": "eslint . --config ../../eslint.config.js",
    "test": "tsc -p tsconfig.test.json && node --test '.test-dist/**/*.test.js'",
    "clean": "rm -rf dist .test-dist *.tsbuildinfo"
  },
  "peerDependencies": {
    "@qaf/rag-core": "workspace:*",
    "@qaf/core": "workspace:*",
    "@playwright/test": ">=1.48.0"
  },
  "peerDependenciesMeta": {
    "@qaf/rag-core": {
      "optional": true
    },
    "@qaf/core": {
      "optional": true
    },
    "@playwright/test": {
      "optional": true
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@qaf/core": "workspace:*",
    "@qaf/rag-core": "workspace:*",
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  }
}
