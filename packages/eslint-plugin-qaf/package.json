{
  "name": "@qaf/eslint-plugin-qaf",
  "version": "0.1.0",
  "description": "ESLint rules enforcing QAF conventions: data-testid-routed locators, no console.* usage.",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint . --config ../../eslint.config.js",
    "test": "node --test --experimental-strip-types 'src/**/*.test.ts'",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "peerDependencies": {
    "eslint": ">=9.0.0"
  },
  "devDependencies": {
    "@types/eslint": "^9.6.1",
    "@types/estree": "^1.0.6",
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "typescript": "^5.7.2"
  }
}
